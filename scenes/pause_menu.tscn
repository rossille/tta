[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/pause_menu.gd" id="1_pause"]

[node name="PauseMenu" type="CanvasLayer"]
script = ExtResource("1_pause")

[node name="Dimmer" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0, 0.0, 0.0, 0.5)
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -140.0
offset_top = -100.0
offset_right = 140.0
offset_bottom = 100.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Panel/VBox"]
text = "MENU"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 26

[node name="ResumeBtn" type="Button" parent="Panel/VBox"]
custom_minimum_size = Vector2(0, 44)
text = "Close menu"
theme_override_font_sizes/font_size = 18

[node name="FullscreenBtn" type="Button" parent="Panel/VBox"]
custom_minimum_size = Vector2(0, 44)
text = "Fullscreen"
theme_override_font_sizes/font_size = 18

[node name="QuitBtn" type="Button" parent="Panel/VBox"]
custom_minimum_size = Vector2(0, 44)
text = "Quit"
theme_override_font_sizes/font_size = 18

[connection signal="pressed" from="Panel/VBox/ResumeBtn"     to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Panel/VBox/FullscreenBtn" to="." method="_on_fullscreen_pressed"]
[connection signal="pressed" from="Panel/VBox/QuitBtn"       to="." method="_on_quit_pressed"]
